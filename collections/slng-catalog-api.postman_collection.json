      "item": [
        {
          "id": "a739e391-4be4-4ba8-a15d-254f858d8809",
          "name": "List catalog models",
          "request": {
            "name": "List catalog models",
            "description": {
              "content": "List the models available in the SLNG catalog. Supports filtering by service type, provider, region, language, use case, capability, and protocol, plus full-text search and pagination. Authentication is optional — an API key personalizes pricing and region availability for your organisation; anonymous requests return public catalog data.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "catalog",
                "models"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "service_type",
                  "value": "<string>",
                  "description": "Filter models by service type."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Filter models by supported language code (for example `en`)."
                },
                {
                  "disabled": false,
                  "key": "provider",
                  "value": "<string>",
                  "description": "Filter models by provider code (for example `rime`)."
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "Filter models by region code (for example `eu-north-1`)."
                },
                {
                  "disabled": false,
                  "key": "use_case",
                  "value": "<string>",
                  "description": "Filter models by use case tag."
                },
                {
                  "disabled": false,
                  "key": "capability",
                  "value": "<string>",
                  "description": "Filter models by capability tag."
                },
                {
                  "disabled": false,
                  "key": "protocol",
                  "value": "<string>",
                  "description": "Filter models by supported protocol."
                },
                {
                  "disabled": false,
                  "key": "slng_hosted_only",
                  "value": "<boolean>",
                  "description": "When true, return only SLNG-hosted models. Accepts `true`, `false`, `1`, or `0`."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Full-text search across model names and descriptions."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number to return (1-based). Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "20",
                  "description": "The number of items per page. Defaults to 20."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "noauth"
            }
