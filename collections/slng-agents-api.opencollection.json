{
  "opencollection": "1.0.0",
  "info": {
    "name": "SLNG Voice Account Agents API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agents.slng.ai/v1/agents"
          },
          "docs": "List all voice agents for your organisation."
        },
        {
          "info": {
            "name": "Create agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agents.slng.ai/v1/agents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new voice agent."
        },
        {
          "info": {
            "name": "Get agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agents.slng.ai/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "Voice agent ID."
              }
            ]
          },
          "docs": "Get a single voice agent by ID."
        },
        {
          "info": {
            "name": "Replace agent",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.agents.slng.ai/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "Voice agent ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace a voice agent (full update)."
        },
        {
          "info": {
            "name": "Update agent (partial)",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.agents.slng.ai/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "Voice agent ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partially update a voice agent."
        },
        {
          "info": {
            "name": "Delete agent",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.agents.slng.ai/v1/agents/:agent_id",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "Voice agent ID."
              }
            ]
          },
          "docs": "Soft-delete a voice agent."
        },
        {
          "info": {
            "name": "Duplicate agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agents.slng.ai/v1/agents/:agent_id/duplicate",
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path",
                "description": "Voice agent ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a server-side copy of an existing voice agent.\n\nThe duplicate copies the stored agent configuration, including prompts, models, tools,\ntemplate defaults, selected region, and outbound telephony settings.\n\nThe duplicate does not copy call history or the inbound connection. SLNG creates\nand manages a runtime API key for the duplicated agent automatically.\n"
        }
      ]
    }
  ],
  "bundled": true
}